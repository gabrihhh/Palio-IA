#!/bin/bash
# Palio-IA — validação de mensagem de commit
# Formato obrigatório: [QA|MAIN] descrição

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Permitir merge commits
if echo "$commit_msg" | grep -qE "^Merge "; then
    exit 0
fi

# Permitir WIP (temporário, não vai para push pelo pre-push hook)
if echo "$commit_msg" | grep -qiE "^wip:? "; then
    exit 0
fi

# Validar formato: [QA|MAIN] seguido de pelo menos uma palavra
if ! echo "$commit_msg" | grep -qE "^\[(QA|MAIN)\] .+"; then
    echo ""
    echo "  ❌  Commit bloqueado — formato inválido."
    echo ""
    echo "      Recebido : $commit_msg"
    echo "      Esperado : [QA|MAIN] descrição breve em PT-BR"
    echo ""
    echo "      Exemplos:"
    echo "        [QA] adiciona fuzzy matching para wake word"
    echo "        [MAIN] fix: audio duck não restaura volume ao falhar TTS"
    echo "        [QA] refatora dispatcher para suportar novos módulos"
    echo ""
    exit 1
fi

exit 0
