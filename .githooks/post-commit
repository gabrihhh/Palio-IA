#!/bin/bash
# Palio-IA — post-commit: atualiza docs automaticamente quando .py são modificados
#
# Só dispara se:
#   1. Este commit modificou arquivos .py
#   2. Este commit NÃO é o próprio commit de docs (evita loop)
#
# Requer: claude CLI instalado e disponível no PATH

# Guard: se este commit atualizou o docs_hash, é o commit de docs — não re-disparar
if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -q "ai_docs/\.docs_hash"; then
    exit 0
fi

# Conta .py modificados neste commit
py_count=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -cE "\.py$" || echo 0)
[ "$py_count" -eq 0 ] && exit 0

# Verifica se claude CLI está disponível
if ! command -v claude &>/dev/null; then
    echo ""
    echo "  ⚠️   post-commit: claude CLI não encontrado."
    echo "      Execute /update_docs manualmente antes de fazer push."
    echo ""
    exit 0
fi

echo ""
echo "  📝  ${py_count} arquivo(s) .py modificado(s) — atualizando documentação..."
echo ""

# Executa update_docs via claude -p
# --dangerously-skip-permissions: necessário para que claude possa ler/escrever arquivos no hook
claude -p "$(cat .claude/commands/update_docs.md)" --dangerously-skip-permissions 2>&1

exit 0
