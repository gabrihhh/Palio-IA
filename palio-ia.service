# palio-ia.service
#
# Arquivo de referência — gerado automaticamente pelo setup.sh com os caminhos corretos.
#
# Para instalar manualmente:
#   cp palio-ia.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable palio-ia.service
#   systemctl start palio-ia.service

[Unit]
Description=Palio-IA Voice Assistant
After=network.target bluetooth.target sound.target ollama.service
Wants=bluetooth.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Palio-IA
ExecStartPre=/bin/sleep 8
ExecStart=/root/Palio-IA/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"
Environment="XDG_RUNTIME_DIR=/run/user/0"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus"

[Install]
WantedBy=multi-user.target
